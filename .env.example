# ===== 模型供应商（留空则自动进入离线 mock 模式，全链路仍可跑通）=====
# 推荐组合见 docs/05-tech-stack-and-model-selection.md
# VLM：阿里云百炼 Qwen3.7-Plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.7-plus
VLM_ENABLE_THINKING=false          # 必须显式关闭，否则成本 +67%

# 文本 LLM（只做解释润色）：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Embedding：默认走本地确定性哈希编码（零依赖、可复现）
EMBEDDING_MODE=hash                # hash | dashscope
EMBEDDING_DIM=256

# ===== 运行时 =====
APP_ENV=dev
LOG_LEVEL=INFO
RULESET_VERSION=rs-2026.10.1
OFFLINE_MODE=true                  # true 时不发任何外部请求（默认，便于无 key 演示）
